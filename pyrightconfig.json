{
  // Without venvPath/venv, pyright searches whichever interpreter it happens to
  // find and reports every dependency as unresolved — 79 phantom errors on a
  // project whose imports all work. Editors and the CLI both read this file, so
  // they agree on the environment and on the strictness.
  "venvPath": ".",
  "venv": "env",
  "typeCheckingMode": "standard",
  "include": [
    "api",
    "db",
    "repositories",
    "web",
    "tests",
    "app.py",
    "config.py",
    "extensions.py",
    "type_icons.py",
    "uploads.py"
  ],
  "exclude": ["env", "static", "**/__pycache__"]
}
