# Copy to .env and adjust. .env is gitignored; this file is the documented
# template, so add every new variable here as well.
#
# Both the application and docker compose read this file: compose uses it for
# ${VAR} substitution in docker-compose.yml, and passes it into the containers.

# ----------------
# Flask
# ----------------
FLASK_APP=app
# 1 turns on the debugger and the live reloader, in the container too. Never 1
# in production: the debugger offers a remote shell to anyone who can reach it.
FLASK_DEBUG=1

# Signs sessions and, by default, JWTs. CHANGE BOTH IN PRODUCTION.
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me

# Access tokens are short-lived, refresh tokens long-lived, so a leaked access
# token expires quickly while the user stays signed in.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# ----------------
# MySQL
# ----------------
# 127.0.0.1 is correct when running Flask on the host against the compose
# database. docker-compose.yml overrides this to `db` inside the container.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=coisascomgosto
MYSQL_PASSWORD=coisascomgosto
MYSQL_DATABASE=coisascomgosto

# Used by the MySQL container to bootstrap itself, and by the test service,
# which creates and drops its own schema.
MYSQL_ROOT_PASSWORD=root

# ----------------
# Serving
# ----------------
WEB_PORT=5000
# Ignored when FLASK_DEBUG=1, since the dev server is single-process.
GUNICORN_WORKERS=3

# ----------------
# Mail (optional; unset means outgoing mail is disabled)
# ----------------
MAIL_SERVER=
MAIL_PORT=25
MAIL_DEFAULT_SENDER=
