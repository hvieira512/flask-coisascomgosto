# Copy to .env and adjust. .env is gitignored; this file is the documented
# template, so add every new variable here as well.
#
# Both the application and docker compose read this file: compose uses it for
# ${VAR} substitution in docker-compose.yml, and passes it into the containers.

# ----------------
# Laravel
# ----------------
APP_ENV=local
# true shows full errors with stack traces. Never true in production.
APP_DEBUG=true
# Signs and encrypts the session cookie. Generate one with
# `php artisan key:generate`; a placeholder here would be a public key.
APP_KEY=
APP_LOCALE=pt
LOG_CHANNEL=stderr

# The session is an encrypted cookie and the cache is files: no tables and no
# extra services for either.
SESSION_DRIVER=cookie
CACHE_STORE=file

# Signs the API's bearer tokens; at least 32 bytes. CHANGE IN PRODUCTION: the
# app refuses to serve with APP_DEBUG off while it holds this value.
JWT_SECRET_KEY=dev-jwt-secret-change-me-it-is-in-the-repository

# Access tokens are short-lived, refresh tokens long-lived, so a leaked access
# token expires quickly while the user stays signed in.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# ----------------
# MySQL
# ----------------
# 127.0.0.1 is correct when running PHP on the host against the compose
# database. docker-compose.yml overrides this to `db` inside the container.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=coisascomgosto
MYSQL_PASSWORD=coisascomgosto
MYSQL_DATABASE=coisascomgosto

# Used by the MySQL container to bootstrap itself.
MYSQL_ROOT_PASSWORD=root

# ----------------
# Serving
# ----------------
WEB_PORT=5000
